# 複製成 .env 後填入。.env 已被 .gitignore 排除,絕不進版控。
# 比照 memos / sync-skills 的 reference/.env 風格集中管理憑證。

# --- Web Console ---
CRAZYSOUL_DRY_RUN=1
CRAZYSOUL_OUTPUT=output
WEB_PASSWORD=change-me
WEB_SECRET_KEY=change-this-secret

# --- LLM 分鏡產生(Storyboard Generator)---
# 擇一即可,預設用 anthropic。設定 LLM_PROVIDER 切換。
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Image Provider(Flux / SDXL via fal.ai)---
IMAGE_PROVIDER=fal-flux
FAL_KEY=

# --- Video Provider(Kling / Wan via fal.ai)---
VIDEO_PROVIDER=fal-kling

# --- Routing Decision ---
DYNAMIC_RATIO=1.0

# --- 成本護欄(Cost & Retry Guardrail)---
# 單次 run 的預估成本上限(USD),超過就中止。0 = 不限制。
COST_LIMIT_USD=0
# 重試成本係數:預算用實際單價 × 此係數(README 建議 1.3~1.5)
COST_RETRY_FACTOR=1.4
RETRY_MAX_ATTEMPTS=2
RETRY_BACKOFF_SECONDS=0.5

# --- Audio Layer / TTS(Phase 5)---
# dry-run 不會呼叫 API;live 模式預設呼叫 OpenAI /v1/audio/speech。
TTS_PROVIDER=openai-tts
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# 單次 TTS 呼叫的估算成本(USD),用於 cost_log;實際可依帳單定期校正。
TTS_COST_USD=0

# --- pCloud WebDAV(Phase 6)---
PCLOUD_WEBDAV_URL=https://webdav.pcloud.com
PCLOUD_USERNAME=
PCLOUD_PASSWORD=
PCLOUD_REMOTE_DIR=CrazySoul
