# CrazySoul deployment example. Copy to .env and fill secrets.
CRAZYSOUL_DRY_RUN=1
CRAZYSOUL_OUTPUT=/data/output
WEB_PASSWORD=change-me
WEB_SECRET_KEY=change-this-secret

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_KEY=

DYNAMIC_RATIO=1.0
COST_LIMIT_USD=0
COST_RETRY_FACTOR=1.4
RETRY_MAX_ATTEMPTS=2
RETRY_BACKOFF_SECONDS=0.5

PCLOUD_WEBDAV_URL=https://webdav.pcloud.com
PCLOUD_USERNAME=
PCLOUD_PASSWORD=
PCLOUD_REMOTE_DIR=CrazySoul
